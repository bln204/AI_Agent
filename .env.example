# =========================

# DATABASE

# =========================

DB_HOST=localhost
DB_PORT=3306
DB_NAME=ai_agent

DB_URL=jdbc:mysql://${DB_HOST}:${DB_PORT}/${DB_NAME}?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true&useUnicode=true&characterEncoding=UTF-8

DB_USERNAME=root
DB_PASSWORD=your_password

# =========================

# GOOGLE OAUTH2

# =========================

GG_CLIENT_ID=your_google_client_id
GG_CLIENT_SECRET=your_google_client_secret

# Production:

# https://your-domain.com/login/oauth2/code/google

GOOGLE_REDIRECT_URI=http://localhost:8080/login/oauth2/code/google

# =========================

# JWT

# =========================

JWT_SECRET=change_this_to_a_long_random_secure_secret_key

# =========================

# MAIL (SMTP) — dùng để gửi OTP cho chức năng Quên mật khẩu

# =========================

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_smtp_username
# Với Gmail phải dùng App Password (16 ký tự), KHÔNG dùng mật khẩu đăng nhập Google
MAIL_PASSWORD=your_smtp_app_password

# =========================

# GEMINI

# =========================

GEMINI_API_KEY=your_gemini_api_key

# Nếu dùng OpenAI compatible endpoint

GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# =========================

# QDRANT

# =========================

QDRANT_HOST=localhost
QDRANT_PORT=6333

# =========================

# FILE STORAGE

# =========================

APP_UPLOAD_DIR=./uploads

# =========================

# SPRING PROFILE

# =========================

SPRING_PROFILES_ACTIVE=production

# =========================

# EMBEDDING CACHE

# =========================

SPRING_AI_EMBEDDING_TRANSFORMER_CACHE_DIRECTORY=./ai-cache

# =========================

# SERVER

# =========================

SERVER_PORT=8080
